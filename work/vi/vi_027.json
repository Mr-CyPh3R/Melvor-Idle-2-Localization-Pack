{
 "04680": "Các vì sao thắc mắc nguyên liệu đi đâu mỗi khi bạn nấu hỏng một món.",
 "04681": "Chòm sao cho rằng một bữa ăn thịnh soạn giải quyết được nhiều vấn đề. Những vấn đề còn lại thường cần đến vũ khí.",
 "04682": "Chòm sao khẳng định ăn uống giữa trận chiến là một kỹ năng đáng ngưỡng mộ.",
 "04683": "Các vì sao tiết lộ rằng một cái bụng no thường là bước đầu tiên để sống sót qua trận chạm trán kế tiếp.",
 "04684": "Chòm sao cho rằng bữa ăn nào cũng ngon hơn sau khi suýt nữa thì thất bại.",
 "04685": [
  "Quan sát Ko"
 ],
 "04686": "Chòm sao cho rằng cửa khóa chỉ là một lời gợi ý.",
 "04687": "Các vì sao tiết lộ rằng mỗi lần tiếp đất duyên dáng đều được xây trên vô số lần tiếp đất chẳng mấy duyên dáng.",
 "04688": "Các vì sao thắc mắc sao NPC lại không thể móc túi bạn.",
 "04689": "Chòm sao ám chỉ việc nhận hối lộ để đổi lấy thêm độ ẩn nấp.",
 "04690": "Chòm sao thắc mắc sao một món đồ rất cụ thể cứ liên tục xuất hiện trên những lộ trình ngẫu nhiên.",
 "04691": "Chòm sao nhắc bạn rằng nó không thể giúp gì cho vấn đề dụng cụ mở khóa của bạn.",
 "04692": [
  "Quan sát Tellus"
 ],
 "04693": "Các vì sao khẳng định cách phòng thủ tốt nhất là để con quái vật trở thành nhiệm vụ của người khác.",
 "04694": "Chòm sao cho rằng nhiệm vụ diệt quái nào trông cũng hợp lý cho đến khi bạn thực sự tới nơi.",
 "04695": "Các vì sao tiết lộ rằng sửa khiên dễ hơn nhiều so với sửa lòng tự tin.",
 "04696": "Các vì sao tự hỏi liệu các Bậc thầy diệt quái có ngầm thi nhau nghĩ ra những nhiệm vụ ngày càng phiền phức không.",
 "04697": "Chòm sao khẳng định câu \"thêm một con quái nữa thôi\" đã làm chậm biết bao chuyến về nhà.",
 "04698": "Các vì sao tiết lộ rằng mọi thợ diệt quái dày dạn đều từng tự tin tấn công nhầm quái vật ít nhất một lần.",
