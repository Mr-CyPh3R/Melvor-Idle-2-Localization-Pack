"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "MODS"
msgstr "MOD"

msgid "Open a mod window, or change its key."
msgstr "Mở cửa sổ của một mod hoặc đổi phím của nó."

msgid "Close"
msgstr "Đóng"

msgid "Close  ({0})"
msgstr "Đóng ({0})"

msgid "This menu"
msgstr "Menu này"

msgid "this menu"
msgstr "menu này"

msgid "Off"
msgstr "Tắt"

msgid "No mod has a window here yet."
msgstr "Chưa có mod nào có cửa sổ ở đây."

msgid ""
"Click a key to change it, then press the new key (Ctrl, Shift or Alt can "
"come with it; Esc cancels)."
msgstr ""
"Nhấp vào một phím để đổi, rồi nhấn phím mới (có thể kèm Ctrl, Shift hoặc "
"Alt; Esc để hủy)."

msgid ""
"\"Off\" frees the key, the window still opens from here. Saved in "
"mods\\hotkeys.json."
msgstr ""
"“Tắt” sẽ bỏ gán phím, cửa sổ vẫn mở được từ đây. Lưu trong "
"mods\\hotkeys.json."

msgid "Reset all keys"
msgstr "Đặt lại tất cả phím"

msgid "Every key back to what its mod uses by default."
msgstr "Đưa mọi phím về mặc định của mod."

msgid "Mods"
msgstr "Mod"

msgid "Open any mod window, or change or switch off its key."
msgstr "Mở cửa sổ của bất kỳ mod nào, hoặc đổi hay tắt phím của nó."

msgid "Press a key..."
msgstr "Nhấn một phím..."

msgid "Press the new key now. Esc cancels."
msgstr "Nhấn phím mới ngay bây giờ. Esc để hủy."

msgid "Click, then press the new key."
msgstr "Nhấp, rồi nhấn phím mới."

msgid "No key for this window."
msgstr "Cửa sổ này chưa có phím."

msgid "The key that opens this menu."
msgstr "Phím mở menu này."

msgid "Two mods use the same key: open this to fix it."
msgstr "Hai mod dùng cùng một phím: mở mục này để sửa."

msgid "no key"
msgstr "không có phím"

msgid "also used by {0}"
msgstr "cũng được {0} sử dụng"

msgid "Melvor Mod Loader {0}  -  {1} mod"
msgstr "Melvor Mod Loader {0}, số mod: {1}"

msgid ""
"Click a key to change it, then press the new key (Ctrl, Shift or Alt can come with it; Esc cancels).\n"
"\"Off\" frees the key, the window still opens from here. Saved in mods\\hotkeys.json."
msgstr ""
"Nhấp vào một phím để đổi, rồi nhấn phím mới (có thể kèm Ctrl, Shift hoặc Alt; Esc để hủy).\n"
"“Tắt” sẽ bỏ gán phím, cửa sổ vẫn mở được từ đây. Lưu trong mods\\hotkeys.json."

msgid "Mod loader:"
msgstr "Trình tải mod:"

msgid ""
"These mods did not start: {0}. The game may have been updated: look for a "
"newer version of the mod. Details: MelvorModLoader.log."
msgstr ""
"Các mod này không khởi động được: {0}. Có thể trò chơi đã được cập nhật: hãy"
" tìm phiên bản mới hơn của mod. Chi tiết: MelvorModLoader.log."

msgid ""
"This mod did not start: {0}. The game may have been updated: look for a "
"newer version of the mod. Details: MelvorModLoader.log."
msgstr ""
"Mod này không khởi động được: {0}. Có thể trò chơi đã được cập nhật: hãy tìm"
" phiên bản mới hơn của mod. Chi tiết: MelvorModLoader.log."

msgid ""
"The mod {0} ran into an error and part of it was switched off until the game"
" is started again. The game may have been updated: look for a newer version "
"of the mod. Details: MelvorModLoader.log."
msgstr ""
"Mod {0} gặp lỗi và một phần của nó đã bị tắt cho đến lần khởi động trò chơi "
"tiếp theo. Có thể trò chơi đã được cập nhật: hãy tìm phiên bản mới hơn của "
"mod. Chi tiết: MelvorModLoader.log."

msgid "Everything of the removed mods is in your bank now."
msgstr "Mọi thứ của các mod đã gỡ giờ đều nằm trong ngân hàng của bạn."

msgid ""
"{0} item(s) of the removed mod {1} wait for room in your bank. Free some "
"bank slots and they go in by themselves."
msgstr ""
"Vật phẩm của mod đã gỡ {1} (số lượng: {0}) đang chờ chỗ trống trong ngân "
"hàng. Hãy dọn bớt vài ô, chúng sẽ tự vào."

msgid ""
"{0} item(s) of the removed mod {1} are not known to the game now (another "
"mod is missing); they are kept."
msgstr ""
"Vật phẩm của mod đã gỡ {1} (số lượng: {0}) hiện trò chơi không nhận ra "
"(thiếu một mod khác); chúng được giữ lại."

msgid ""
"{0} is installed but did not start, so its items are missing in this "
"session. They were NOT turned into normal items: {1} keeps a copy of them "
"and brings them back when it works again. Look for a newer version of the "
"mod."
msgstr ""
"{0} đã được cài nhưng không khởi động được, nên vật phẩm của nó bị thiếu "
"trong phiên này. Chúng KHÔNG bị đổi thành vật phẩm thường: {1} giữ một bản "
"sao và trả lại khi mod hoạt động trở lại. Hãy tìm phiên bản mới hơn của mod."

msgid "A copy of your save as it is now was kept in mods\\rescue-kept."
msgstr "Một bản sao của bản lưu hiện tại đã được giữ trong mods\\rescue-kept."

msgid ""
"The removed mod {0} kept items in this save, and their list could not be "
"read. Put that mod back before you play on: the game's next save will not "
"hold them."
msgstr ""
"Mod đã gỡ {0} có vật phẩm trong bản lưu này, và không đọc được danh sách của"
" chúng. Hãy cài lại mod đó trước khi chơi tiếp: lần lưu tiếp theo của trò "
"chơi sẽ không còn chúng."

msgid "A copy of the save as it is now was kept in {0}."
msgstr "Một bản sao của bản lưu hiện tại đã được giữ trong {0}."
