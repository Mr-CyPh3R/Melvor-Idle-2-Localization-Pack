msgid ""
msgstr ""
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "MODS"
msgstr "MODY"

msgid "Open a mod window, or change its key."
msgstr "Otwórz okno moda lub zmień jego klawisz."

msgid "Close"
msgstr "Zamknij"

msgid "Close  ({0})"
msgstr "Zamknij ({0})"

msgid "This menu"
msgstr "To menu"

msgid "this menu"
msgstr "to menu"

msgid "Off"
msgstr "Wył."

msgid "No mod has a window here yet."
msgstr "Żaden mod nie ma tu jeszcze okna."

msgid ""
"Click a key to change it, then press the new key (Ctrl, Shift or Alt can "
"come with it; Esc cancels)."
msgstr ""
"Kliknij klawisz, aby go zmienić, a potem naciśnij nowy klawisz (może być z "
"Ctrl, Shift lub Alt; Esc anuluje)."

msgid ""
"\"Off\" frees the key, the window still opens from here. Saved in "
"mods\\hotkeys.json."
msgstr ""
"„Wył.” zwalnia klawisz, okno nadal można otworzyć stąd. Zapisywane w "
"mods\\hotkeys.json."

msgid "Reset all keys"
msgstr "Przywróć wszystkie klawisze"

msgid "Every key back to what its mod uses by default."
msgstr "Przywraca każdy klawisz do domyślnego ustawienia jego moda."

msgid "Mods"
msgstr "Mody"

msgid "Open any mod window, or change or switch off its key."
msgstr "Otwórz dowolne okno moda albo zmień lub wyłącz jego klawisz."

msgid "Press a key..."
msgstr "Naciśnij klawisz..."

msgid "Press the new key now. Esc cancels."
msgstr "Naciśnij teraz nowy klawisz. Esc anuluje."

msgid "Click, then press the new key."
msgstr "Kliknij, a potem naciśnij nowy klawisz."

msgid "No key for this window."
msgstr "To okno nie ma przypisanego klawisza."

msgid "The key that opens this menu."
msgstr "Klawisz, który otwiera to menu."

msgid "Two mods use the same key: open this to fix it."
msgstr "Dwa mody używają tego samego klawisza: otwórz, aby to naprawić."

msgid "no key"
msgstr "brak klawisza"

msgid "also used by {0}"
msgstr "używany też przez: {0}"

msgid "Melvor Mod Loader {0}  -  {1} mod"
msgstr "Melvor Mod Loader {0}, liczba modów: {1}"

msgid ""
"Click a key to change it, then press the new key (Ctrl, Shift or Alt can come with it; Esc cancels).\n"
"\"Off\" frees the key, the window still opens from here. Saved in mods\\hotkeys.json."
msgstr ""
"Kliknij klawisz, aby go zmienić, a potem naciśnij nowy klawisz (może być z Ctrl, Shift lub Alt; Esc anuluje).\n"
"„Wył.” zwalnia klawisz, okno nadal można otworzyć stąd. Zapisywane w mods\\hotkeys.json."

msgid "Mod loader:"
msgstr "Mod Loader:"

msgid ""
"These mods did not start: {0}. The game may have been updated: look for a "
"newer version of the mod. Details: MelvorModLoader.log."
msgstr ""
"Te mody się nie uruchomiły: {0}. Gra mogła zostać zaktualizowana: poszukaj "
"nowszej wersji moda. Szczegóły: MelvorModLoader.log."

msgid ""
"This mod did not start: {0}. The game may have been updated: look for a "
"newer version of the mod. Details: MelvorModLoader.log."
msgstr ""
"Ten mod się nie uruchomił: {0}. Gra mogła zostać zaktualizowana: poszukaj "
"nowszej wersji moda. Szczegóły: MelvorModLoader.log."

msgid ""
"The mod {0} ran into an error and part of it was switched off until the game"
" is started again. The game may have been updated: look for a newer version "
"of the mod. Details: MelvorModLoader.log."
msgstr ""
"Mod {0} napotkał błąd i jego część została wyłączona do ponownego "
"uruchomienia gry. Gra mogła zostać zaktualizowana: poszukaj nowszej wersji "
"moda. Szczegóły: MelvorModLoader.log."

msgid "Everything of the removed mods is in your bank now."
msgstr "Wszystko z usuniętych modów jest już w twoim banku."

msgid ""
"{0} item(s) of the removed mod {1} wait for room in your bank. Free some "
"bank slots and they go in by themselves."
msgstr ""
"Przedmioty usuniętego moda {1} (liczba: {0}) czekają na miejsce w banku. "
"Zwolnij kilka miejsc, a trafią tam same."

msgid ""
"{0} item(s) of the removed mod {1} are not known to the game now (another "
"mod is missing); they are kept."
msgstr ""
"Przedmioty usuniętego moda {1} (liczba: {0}) są teraz nieznane grze (brakuje"
" innego moda); są przechowywane."

msgid ""
"{0} is installed but did not start, so its items are missing in this "
"session. They were NOT turned into normal items: {1} keeps a copy of them "
"and brings them back when it works again. Look for a newer version of the "
"mod."
msgstr ""
"{0} jest zainstalowany, ale się nie uruchomił, więc jego przedmiotów brakuje"
" w tej sesji. NIE zamieniono ich w zwykłe przedmioty: {1} przechowuje ich "
"kopię i odda je, gdy mod znów zadziała. Poszukaj nowszej wersji moda."

msgid "A copy of your save as it is now was kept in mods\\rescue-kept."
msgstr "Kopia twojego obecnego zapisu jest w mods\\rescue-kept."

msgid ""
"The removed mod {0} kept items in this save, and their list could not be "
"read. Put that mod back before you play on: the game's next save will not "
"hold them."
msgstr ""
"Usunięty mod {0} miał przedmioty w tym zapisie, a ich listy nie dało się "
"odczytać. Przywróć ten mod, zanim zagrasz dalej: następny zapis gry nie "
"będzie ich zawierał."

msgid "A copy of the save as it is now was kept in {0}."
msgstr "Kopia obecnego zapisu jest w {0}."
