msgid ""
msgstr ""
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "MODS"
msgstr "MODS"

msgid "Open a mod window, or change its key."
msgstr "Abra uma janela de mod ou altere sua tecla."

msgid "Close"
msgstr "Fechar"

msgid "Close  ({0})"
msgstr "Fechar ({0})"

msgid "This menu"
msgstr "Este menu"

msgid "this menu"
msgstr "este menu"

msgid "Off"
msgstr "Nenhuma"

msgid "No mod has a window here yet."
msgstr "Nenhum mod tem uma janela aqui ainda."

msgid ""
"Click a key to change it, then press the new key (Ctrl, Shift or Alt can "
"come with it; Esc cancels)."
msgstr ""
"Clique em uma tecla para alterá-la e pressione a nova tecla (Ctrl, Shift ou "
"Alt podem acompanhar; Esc cancela)."

msgid ""
"\"Off\" frees the key, the window still opens from here. Saved in "
"mods\\hotkeys.json."
msgstr ""
"“Nenhuma” libera a tecla; a janela continua abrindo por aqui. Salvo em "
"mods\\hotkeys.json."

msgid "Reset all keys"
msgstr "Redefinir todas as teclas"

msgid "Every key back to what its mod uses by default."
msgstr "Volta cada tecla ao padrão do seu mod."

msgid "Mods"
msgstr "Mods"

msgid "Open any mod window, or change or switch off its key."
msgstr "Abra qualquer janela de mod ou altere ou desative sua tecla."

msgid "Press a key..."
msgstr "Pressione uma tecla..."

msgid "Press the new key now. Esc cancels."
msgstr "Pressione a nova tecla agora. Esc cancela."

msgid "Click, then press the new key."
msgstr "Clique e pressione a nova tecla."

msgid "No key for this window."
msgstr "Nenhuma tecla para esta janela."

msgid "The key that opens this menu."
msgstr "A tecla que abre este menu."

msgid "Two mods use the same key: open this to fix it."
msgstr "Dois mods usam a mesma tecla: abra isto para corrigir."

msgid "no key"
msgstr "sem tecla"

msgid "also used by {0}"
msgstr "também usada por {0}"

msgid "Melvor Mod Loader {0}  -  {1} mod"
msgstr "Melvor Mod Loader {0}, mods: {1}"

msgid ""
"Click a key to change it, then press the new key (Ctrl, Shift or Alt can come with it; Esc cancels).\n"
"\"Off\" frees the key, the window still opens from here. Saved in mods\\hotkeys.json."
msgstr ""
"Clique em uma tecla para alterá-la e pressione a nova tecla (Ctrl, Shift ou Alt podem acompanhar; Esc cancela).\n"
"“Nenhuma” libera a tecla; a janela continua abrindo por aqui. Salvo em mods\\hotkeys.json."

msgid "Mod loader:"
msgstr "Mod Loader:"

msgid ""
"These mods did not start: {0}. The game may have been updated: look for a "
"newer version of the mod. Details: MelvorModLoader.log."
msgstr ""
"Estes mods não iniciaram: {0}. O jogo pode ter sido atualizado: procure uma "
"versão mais nova do mod. Detalhes: MelvorModLoader.log."

msgid ""
"This mod did not start: {0}. The game may have been updated: look for a "
"newer version of the mod. Details: MelvorModLoader.log."
msgstr ""
"Este mod não iniciou: {0}. O jogo pode ter sido atualizado: procure uma "
"versão mais nova do mod. Detalhes: MelvorModLoader.log."

msgid ""
"The mod {0} ran into an error and part of it was switched off until the game"
" is started again. The game may have been updated: look for a newer version "
"of the mod. Details: MelvorModLoader.log."
msgstr ""
"O mod {0} teve um erro e uma parte dele foi desligada até o jogo ser "
"iniciado de novo. O jogo pode ter sido atualizado: procure uma versão mais "
"nova do mod. Detalhes: MelvorModLoader.log."

msgid "Everything of the removed mods is in your bank now."
msgstr "Tudo dos mods removidos já está no seu banco."

msgid ""
"{0} item(s) of the removed mod {1} wait for room in your bank. Free some "
"bank slots and they go in by themselves."
msgstr ""
"Itens do mod removido {1} (quantidade: {0}) esperam espaço no seu banco. "
"Libere alguns espaços e eles entram sozinhos."

msgid ""
"{0} item(s) of the removed mod {1} are not known to the game now (another "
"mod is missing); they are kept."
msgstr ""
"Itens do mod removido {1} (quantidade: {0}) não são conhecidos pelo jogo "
"agora (falta outro mod); eles ficam guardados."

msgid ""
"{0} is installed but did not start, so its items are missing in this "
"session. They were NOT turned into normal items: {1} keeps a copy of them "
"and brings them back when it works again. Look for a newer version of the "
"mod."
msgstr ""
"{0} está instalado mas não iniciou, por isso os itens dele faltam nesta "
"sessão. Eles NÃO viraram itens normais: {1} guarda uma cópia e os devolve "
"quando o mod voltar a funcionar. Procure uma versão mais nova do mod."

msgid "A copy of your save as it is now was kept in mods\\rescue-kept."
msgstr "Uma cópia do seu save atual foi guardada em mods\\rescue-kept."

msgid ""
"The removed mod {0} kept items in this save, and their list could not be "
"read. Put that mod back before you play on: the game's next save will not "
"hold them."
msgstr ""
"O mod removido {0} tinha itens neste save, e a lista deles não pôde ser "
"lida. Reinstale esse mod antes de continuar: o próximo save do jogo não vai "
"conter esses itens."

msgid "A copy of the save as it is now was kept in {0}."
msgstr "Uma cópia do save atual foi guardada em {0}."
