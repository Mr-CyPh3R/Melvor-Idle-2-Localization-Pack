#. TRANSLATORS: AgilityCourse.DisplayName
#: Data/Packages/MelvorBase.json
msgid "Ashen Lands Trail"
msgstr "Тропа Пепельных земель"

#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid ""
"Unlocks the [color=#FFD16D]Ashen Tree[/color] in Woodcutting which provide "
"[color=#FFD16D]Ashen Logs[/color] used in various areas of the game."
msgstr ""
"Открывает [color=#FFD16D]пепельное дерево[/color] в рубке леса. Оно дает "
"[color=#FFD16D]пепельные бревна[/color], которые используются во многих "
"частях игры."

#. TRANSLATORS: AgilityCourse.DisplayName
#: Data/Packages/MelvorBase.json
msgid "Dense Cave Trail"
msgstr "Тропа Тесной пещеры"

#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid ""
"Unlocks the [color=#FFD16D]Dense Coal Rock[/color] in Mining which is a much"
" more efficient source of [color=#FFD16D]Coal[/color]."
msgstr ""
"Открывает [color=#FFD16D]плотную угольную жилу[/color] в горном деле: "
"гораздо более эффективный источник [color=#FFD16D]угля[/color]."

#. TRANSLATORS: AgilityCourse.DisplayName
#: Data/Packages/MelvorBase.json
msgid "Torag Grounds Trail"
msgstr "Тропа Угодий торагов"

#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid ""
"Unlocks the [color=#FFD16D]Torag Grounds[/color] Location in Hunting, "
"allowing you to hunt [color=#FFD16D]Torag[/color] which drop materials for "
"high-level gear."
msgstr ""
"Открывает локацию [color=#FFD16D]Угодья торагов[/color] в охоте. Там можно "
"охотиться на [color=#FFD16D]торагов[/color], из которых выпадают материалы "
"для высокоуровневого снаряжения."

