#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid ""
"Unlocks the [color=#FFD16D]Ashen Tree[/color] in Woodcutting which provide "
"[color=#FFD16D]Ashen Logs[/color] used in various areas of the game."
msgstr ""
"Desbloqueia a [color=#FFD16D]Árvore Cinzenta[/color] no Corte de Lenha, que "
"fornece [color=#FFD16D]Toras Cinzentas[/color] usadas em várias áreas do "
"jogo."

#. TRANSLATORS: AgilityCourse.DisplayName
#: Data/Packages/MelvorBase.json
msgid "Dense Cave Trail"
msgstr "Trilha da Caverna Densa"

#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid ""
"Unlocks the [color=#FFD16D]Dense Coal Rock[/color] in Mining which is a much"
" more efficient source of [color=#FFD16D]Coal[/color]."
msgstr ""
"Desbloqueia a [color=#FFD16D]Rocha de Carvão Densa[/color] na Mineração, uma"
" fonte muito mais eficiente de [color=#FFD16D]Carvão[/color]."

#. TRANSLATORS: AgilityCourse.DisplayName
#: Data/Packages/MelvorBase.json
msgid "Torag Grounds Trail"
msgstr "Trilha dos Campos Torag"

#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid ""
"Unlocks the [color=#FFD16D]Torag Grounds[/color] Location in Hunting, "
"allowing you to hunt [color=#FFD16D]Torag[/color] which drop materials for "
"high-level gear."
msgstr ""
"Desbloqueia o local [color=#FFD16D]Campos Torag[/color] na Caça, permitindo "
"que você cace [color=#FFD16D]Torags[/color], que deixam cair materiais para "
"equipamentos de alto nível."

