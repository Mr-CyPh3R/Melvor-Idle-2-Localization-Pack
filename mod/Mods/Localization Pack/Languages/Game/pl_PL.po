#: Data/Packages/MelvorBase.json
msgid "Ashen Lands Trail"
msgstr "Szlak Popielnych Ziem"

#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid ""
"Unlocks the [color=#FFD16D]Ashen Tree[/color] in Woodcutting which provide "
"[color=#FFD16D]Ashen Logs[/color] used in various areas of the game."
msgstr ""
"Odblokowuje w Drwalnictwie [color=#FFD16D]popielne drzewo[/color], które "
"daje [color=#FFD16D]popielne kłody[/color] przydatne w wielu miejscach gry."

#. TRANSLATORS: AgilityCourse.DisplayName
#: Data/Packages/MelvorBase.json
msgid "Dense Cave Trail"
msgstr "Szlak Gęstej Jaskini"

#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid ""
"Unlocks the [color=#FFD16D]Dense Coal Rock[/color] in Mining which is a much"
" more efficient source of [color=#FFD16D]Coal[/color]."
msgstr ""
"Odblokowuje w Górnictwie [color=#FFD16D]skałę zbitego węgla[/color], która "
"jest znacznie wydajniejszym źródłem [color=#FFD16D]węgla[/color]."

#. TRANSLATORS: AgilityCourse.DisplayName
#: Data/Packages/MelvorBase.json
msgid "Torag Grounds Trail"
msgstr "Szlak Ziem Toragów"

#. TRANSLATORS: AgilityCourse.Description
#: Data/Packages/MelvorBase.json
msgid ""
"Unlocks the [color=#FFD16D]Torag Grounds[/color] Location in Hunting, "
"allowing you to hunt [color=#FFD16D]Torag[/color] which drop materials for "
"high-level gear."
msgstr ""
"Odblokowuje w Łowiectwie lokację [color=#FFD16D]Ziemie Toragów[/color], "
"gdzie możesz polować na [color=#FFD16D]toragi[/color], z których wypadają "
"materiały na ekwipunek wysokiego poziomu."

